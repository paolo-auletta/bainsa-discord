DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Required for production command registration to synchronize board-only slash-command visibility.
# Store only in your local .env or secret manager; never commit it.
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DATABASE_URL=
# Optional private CA certificate for verified TLS connections to a remote database.
# Keep the certificate in your secret manager or local .env; never commit its contents.
DATABASE_SSL_CA=
# Use this instead when your hosting provider cannot store multiline variables.
# Generate with: base64 < prod-ca-2021.crt | tr -d '\\n'
DATABASE_SSL_CA_B64=

# Optional. If omitted, the feedback channel asks members to contact the board.
ANONYMOUS_FEEDBACK_URL=

# debug | info | warn | error
LOG_LEVEL=info
