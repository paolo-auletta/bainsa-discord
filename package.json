{
  "name": "bainsa-discord-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BAINSA Discord provisioning, onboarding, permissions, and project management bot.",
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10.0.0 <11"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "build": "npm run typecheck && tsc --project tsconfig.test.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:tests": "npm run build && node dist/scripts/check-test-typecheck.js",
    "start": "node --enable-source-maps --env-file=.env dist/src/bot.js",
    "dev": "npm run build && node --enable-source-maps dist/scripts/dev.js",
    "commands:register": "node --enable-source-maps --env-file=.env dist/scripts/register-commands.js",
    "db:migrate": "node --enable-source-maps --env-file=.env dist/scripts/migrate.js",
    "db:reset": "node --enable-source-maps --env-file=.env dist/scripts/reset-database.js",
    "provision": "node --enable-source-maps --env-file=.env dist/scripts/provision-discord.js",
    "provision:dry-run": "node --enable-source-maps --env-file=.env dist/scripts/provision-discord.js --dry-run",
    "discord:reset": "node --enable-source-maps --env-file=.env dist/scripts/reset-discord.js",
    "discord:bootstrap": "node --enable-source-maps --env-file=.env dist/scripts/bootstrap-member.js",
    "check": "npm run typecheck",
    "lint": "eslint src scripts test",
    "format:check": "npm run build && node dist/scripts/check-format.js",
    "test": "npm run build && DISCORD_TOKEN=test-token DISCORD_CLIENT_ID=test-client DISCORD_GUILD_ID=test-guild DATABASE_URL=postgres://localhost/test node --enable-source-maps --test dist/test/*.test.js",
    "test:integration": "npm run build && node --enable-source-maps dist/scripts/test-integration.js",
    "test:connections": "node --enable-source-maps --env-file=.env dist/scripts/test-connections.js"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "pg": "^8.22.0"
  },
  "overrides": {
    "undici": "6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
